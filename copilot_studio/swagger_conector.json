{
  "swagger": "2.0",
  "info": {
    "title": "AI_Gateway_Gobernanza",
    "description": "Gateway de Gobernanza de IA - 5 Endpoints Integrados",
    "version": "2.3"
  },
  "host": "func-gobernanza-core-v-avfqdnedb2e2g5c2.eastus-01.azurewebsites.net",
  "basePath": "/api",
  "schemes": ["https"],
  "securityDefinitions": {
    "function_key": {
      "type": "apiKey",
      "name": "x-functions-key",
      "in": "header"
    }
  },
  "security": [
    {
      "function_key": []
    }
  ],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/evaluate-prompt": {
      "post": {
        "summary": "Evaluar Prompt DLP",
        "operationId": "EvaluatePrompt",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "prompt": { "type": "string" },
                "userId": { "type": "string" }
              },
              "required": ["prompt"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "riskLevel": { "type": "string" },
                "message": { "type": "string" },
                "respuestaEjecutiva": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/create-agent": {
      "post": {
        "summary": "Aprobar y Desplegar Agente",
        "operationId": "CreateAgent",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "solicitud": { "type": "string" },
                "agentObjectId": { "type": "string" },
                "recipientEmail": { "type": "string" },
                "approvalToken": {
                  "type": "string",
                  "description": "Token firmado por el servicio de aprobación. Formato base64url(payload JSON).base64url(HMAC-SHA256 del primer segmento). El payload incluye action, targetId, detailsSha256, approvedBy, approvalId, issuedAt y expiresAt; para crear, action=deploy-agent, targetId=agentObjectId y detailsSha256=SHA-256(solicitud UTF-8); vigencia máxima 10 minutos."
                }
              },
              "required": ["solicitud"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "estadoFinal": { "type": "string" },
                "respuestaEjecutiva": { "type": "string" }
              }
            }
          },
          "403": {
            "description": "Aprobación firmada inválida, vencida o no autorizada"
          },
          "503": {
            "description": "Despliegue deshabilitado por configuración de aprobación ausente"
          }
        }
      }
    },
    "/get-full-audit": {
      "get": {
        "summary": "Consultar resumen del inventario de agentes",
        "description": "Devuelve un resumen del inventario unificado y las fuentes de datos. Para buscar o filtrar resultados, usa GetFullAuditFiltered.",
        "operationId": "GetFullAuditGeneral",
        "responses": {
          "200": {
            "description": "Resultado de auditoría global",
            "schema": {
              "type": "object",
              "properties": {
                "respuestaEjecutiva": { "type": "string" },
                "estadoCobertura": { "type": "string" },
                "coberturaPermisosAplicacion": { "type": "string" },
                "tiempoRespuestaSegundos": { "type": "number" },
                "totalFiltrados": { "type": "integer" },
                "metricasAgentMap": { "type": "object" },
                "fuentes": { "type": "object" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Buscar aplicativos, agentes de IA y recursos empresariales",
        "description": "Busca en nombres, identificadores, App IDs, descripciones y plataformas del inventario de Entra ID, Microsoft 365 Agent 365 Package Management, Azure Resource Graph y Defender XDR. Agent 365 requiere licencia y CopilotPackages.Read.All; las conexiones de terceros deben estar configuradas y sincronizadas en el centro de administración. El filtro ia devuelve candidatos detectados por metadatos, no una certificación.",
        "operationId": "GetFullAuditFiltered",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "filter": {
                  "type": "string",
                  "description": "all, ia, agentes, riesgo, aplicaciones, azure_ai, defender, no_administrados o sin_propietario",
                  "enum": ["all", "ia", "agentes", "riesgo", "aplicaciones", "azure_ai", "defender", "no_administrados", "sin_propietario"],
                  "default": "all"
                },
                "search": {
                  "type": "string",
                  "description": "Nombre, Object ID, App ID, descripción o plataforma; omitir para no buscar por texto",
                  "default": ""
                },
                "limit": {
                  "type": "integer",
                  "description": "Máximo 500 resultados por página",
                  "default": 100
                },
                "offset": {
                  "type": "integer",
                  "description": "Número de resultados a omitir para paginar",
                  "default": 0
                }
              },
              "required": ["filter"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "respuestaEjecutiva": { "type": "string" },
                "status": { "type": "string" },
                "estadoCobertura": { "type": "string" },
                "fuentes": { "type": "object" },
                "metricasGlobales": { "type": "object" },
                "coberturaPermisosAplicacion": { "type": "string" },
                "tiempoRespuestaSegundos": { "type": "number" },
                "totalFiltrados": { "type": "integer" },
                "limit": { "type": "integer" },
                "offset": { "type": "integer" },
                "tieneMasResultados": { "type": "boolean" },
                "agentes": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      }
    },
    "/execute-remediation": {
      "post": {
        "summary": "Ejecutar Remediación / Cuarentena SOC",
        "operationId": "ExecuteRemediation",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "botId": { "type": "string" },
                "searchQuery": { "type": "string" },
                "tipoAccion": {
                  "type": "string",
                  "enum": ["SoftDelete", "HardDelete"],
                  "default": "SoftDelete"
                },
                "confirmHardDelete": {
                  "type": "boolean",
                  "description": "Debe ser true para ejecutar HardDelete. Solo enviar tras confirmación explícita del usuario.",
                  "default": false
                },
                "recipientEmail": { "type": "string" },
                "approvalToken": {
                  "type": "string",
                  "description": "Obligatorio para toda remediación. Token HMAC firmado, limitado al targetId del service principal, action=quarantine-agent o hard-delete-agent y detailsSha256=SHA-256(tipoAccion en minúsculas)."
                }
              },
              "description": "Proporciona botId o searchQuery y una aprobación firmada para la acción y el service principal resuelto. HardDelete también requiere confirmHardDelete=true.",
              "required": ["approvalToken"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "message": { "type": "string" },
                "respuestaEjecutiva": { "type": "string" }
              }
            }
          },
          "403": {
            "description": "Aprobación firmada inválida, vencida o no autorizada"
          },
          "503": {
            "description": "Remediación deshabilitada por configuración de aprobación ausente"
          }
        }
      }
    },
    "/send-notification": {
      "post": {
        "summary": "Enviar Notificación HTML (Auditoría, Creación o Remediación)",
        "operationId": "SendNotification",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "recipientEmail": { "type": "string" },
                "tipoReporte": {
                  "type": "string",
                  "enum": ["auditoria", "creacion", "remediacion"],
                  "default": "auditoria"
                },
                "filter": {
                  "type": "string",
                  "enum": ["riesgo", "no_administrados", "sin_propietario", "all"],
                  "default": "riesgo"
                },
                "search": { "type": "string" },
                "detalleEvento": { "type": "string" }
              },
              "required": ["recipientEmail"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "message": { "type": "string" },
                "respuestaEjecutiva": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
