{
  "swagger": "2.0",
  "info": {
    "title": "AI_Gateway_Gobernanza",
    "description": "Gateway de Gobernanza de IA - 5 Endpoints Integrados",
    "version": "2.3"
  },
  "host": "func-gobernanza-core-v-avfqdnedb2e2g5c2.eastus-01.azurewebsites.net",
  "basePath": "/api",
  "schemes": ["https"],
  "securityDefinitions": {
    "function_key": {
      "type": "apiKey",
      "name": "x-functions-key",
      "in": "header"
    }
  },
  "security": [
    {
      "function_key": []
    }
  ],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/evaluate-prompt": {
      "post": {
        "summary": "Evaluar Prompt DLP",
        "operationId": "EvaluatePrompt",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "prompt": { "type": "string" },
                "userId": { "type": "string" }
              },
              "required": ["prompt"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "riskLevel": { "type": "string" },
                "message": { "type": "string" },
                "respuestaEjecutiva": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/create-agent": {
      "post": {
        "summary": "Aprobar y Desplegar Agente",
        "operationId": "CreateAgent",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "solicitud": { "type": "string" },
                "agentObjectId": { "type": "string" },
                "recipientEmail": { "type": "string" }
              },
              "required": ["solicitud"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "estadoFinal": { "type": "string" },
                "respuestaEjecutiva": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/get-full-audit": {
      "get": {
        "summary": "Ejecutar auditoría general de todos los agentes",
        "description": "Audita toda la organización inmediatamente. No requiere filtro ni término de búsqueda. Usa esta operación para auditorías generales.",
        "operationId": "GetFullAuditGeneral",
        "responses": {
          "200": {
            "description": "Resultado de auditoría global",
            "schema": {
              "type": "object",
              "properties": {
                "respuestaEjecutiva": { "type": "string" },
                "estadoCobertura": { "type": "string" },
                "coberturaPermisosAplicacion": { "type": "string" },
                "tiempoRespuestaSegundos": { "type": "number" },
                "totalFiltrados": { "type": "integer" },
                "metricasAgentMap": { "type": "object" },
                "fuentes": { "type": "object" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Buscar o filtrar agentes",
        "description": "Usa esta operación solo cuando el usuario solicite explícitamente una búsqueda o un subconjunto. Para auditoría general usa GetFullAuditGeneral.",
        "operationId": "GetFullAuditFiltered",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "filter": {
                  "type": "string",
                  "description": "all, riesgo, no_administrados o sin_propietario",
                  "enum": ["all", "riesgo", "no_administrados", "sin_propietario"],
                  "default": "all"
                },
                "search": {
                  "type": "string",
                  "description": "Nombre, Object ID o App ID; omitir para no buscar por nombre",
                  "default": ""
                },
                "limit": {
                  "type": "integer",
                  "description": "Máximo de resultados a mostrar",
                  "default": 50
                }
              },
              "required": ["filter"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "respuestaEjecutiva": { "type": "string" },
                "tiempoRespuestaSegundos": { "type": "number" },
                "totalFiltrados": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "/execute-remediation": {
      "post": {
        "summary": "Ejecutar Remediación / Cuarentena SOC",
        "operationId": "ExecuteRemediation",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "botId": { "type": "string" },
                "searchQuery": { "type": "string" },
                "tipoAccion": {
                  "type": "string",
                  "enum": ["SoftDelete", "HardDelete"],
                  "default": "SoftDelete"
                },
                "confirmHardDelete": {
                  "type": "boolean",
                  "description": "Debe ser true para ejecutar HardDelete. Solo enviar tras confirmación explícita del usuario.",
                  "default": false
                },
                "recipientEmail": { "type": "string" }
              },
              "description": "Proporciona botId o searchQuery. HardDelete requiere confirmHardDelete=true."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "message": { "type": "string" },
                "respuestaEjecutiva": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/send-notification": {
      "post": {
        "summary": "Enviar Notificación HTML (Auditoría, Creación o Remediación)",
        "operationId": "SendNotification",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "recipientEmail": { "type": "string" },
                "tipoReporte": {
                  "type": "string",
                  "enum": ["auditoria", "creacion", "remediacion"],
                  "default": "auditoria"
                },
                "filter": {
                  "type": "string",
                  "enum": ["riesgo", "no_administrados", "sin_propietario", "all"],
                  "default": "riesgo"
                },
                "search": { "type": "string" },
                "detalleEvento": { "type": "string" }
              },
              "required": ["recipientEmail"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "message": { "type": "string" },
                "respuestaEjecutiva": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
